# PostgreSQL Connection URL
# Example for Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Example for Neon: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Example for Local: postgresql://postgres:postgres@localhost:5432/shipyon_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shipyon_db

# Admin Dashboard Password (Change this to a strong password)
ADMIN_PASSWORD=admin123

# Admin Secret Key for signing session tokens
ADMIN_SECRET=core_and_culm_admin_secret_key_2026

# Instant Email Notifications (Free 3,000 emails/month via https://resend.com)
# Get your free API key at https://resend.com (No credit card needed)
RESEND_API_KEY=
NOTIFY_EMAIL=Coreandculm@gmail.com
